# Copy this file to .env for local overrides. Never commit real secrets.
APP_NAME=RAGs to Riches
APP_ENV=development
LOG_LEVEL=INFO

# Optional when Streamlit and FastAPI run separately.
HR_API_URL=http://127.0.0.1:8000

# Enables grounded answer generation through OpenRouter. Keep the real key in
# `.env` or the deployment secret store; never commit it.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=dots-studio/dots-3-note-preview:free
